# Copy to .env and fill in. Never commit the real file (.env is gitignored).

# Kalshi -- only required for private/authenticated endpoints (trading).
# Public market data (list_markets, get_orderbook, candlesticks) needs none.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Polymarket -- only required for placing orders. Public Gamma/CLOB
# market data needs no credentials.
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

ARB_SQLITE_PATH=data/arb.sqlite3
ARB_POLL_INTERVAL_SECONDS=45

# Arbitrage verification engine (arb.arbitrage) -- required only for the
# Opportunities scanner (rule extraction + world-state proposal). Get a
# key at https://console.anthropic.com/. The discovery/divergence scanner
# (serve_dashboard.py's main table) does not need this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Below this confidence (0-1), a mathematically "guaranteed" result is
# downgraded to "manual verification required" rather than shown as
# TRUE ARBITRAGE or CAPITAL-PRESERVING HEDGE -- see arb/arbitrage/payoff.py.
ARB_MIN_RULE_CONFIDENCE=0.9
# Per-opportunity capital ceiling the stake optimizer sizes within, in cents.
ARB_CAPITAL_LIMIT_CENTS=1000000
